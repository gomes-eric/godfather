# Copy to .env and fill in. Never commit .env.

# Discord application (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Public URL of the MCP endpoint. Tailscale Funnel for now; swap for your own domain later.
PUBLIC_BASE_URL=https://padrinho.example.ts.net

HTTP_PORT=8080
DATABASE_PATH=./data/padrinho.db
SERVER_CONFIG_PATH=./server.yaml
LOG_LEVEL=info
# true only after enabling "Message Content Intent" in the Developer Portal (used by read_messages)
DISCORD_MESSAGE_CONTENT=false
# development | production | test (development enables pretty logs)
NODE_ENV=development

# Docker only: gid of the server user that owns server.yaml (the deploy wizard writes `id -g`).
# HOST_GID=1001

# Optional: Claude news summaries through Workload Identity Federation (README §7).
# Never set ANTHROPIC_API_KEY: it would take precedence over federation.
# ANTHROPIC_FEDERATION_RULE_ID=fdrl_...
# ANTHROPIC_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
# ANTHROPIC_SERVICE_ACCOUNT_ID=svac_...
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
